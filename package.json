{
  "name": "electron-vue-element-plus",
  "version": "1.0.0",
  "description": "Electron desktop app with Vue 3, Element Plus and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "backend:setup": "uv sync --directory backend --frozen",
    "test:backend": "uv run --directory backend --frozen pytest",
    "test:backend-integration": "node --experimental-strip-types --test tests/python-backend.test.mjs",
    "build:backend": "uv run --directory backend --frozen python build_backend.py",
    "predev": "npm run backend:setup",
    "test:chat-sdk": "node --experimental-strip-types --test tests/codex-sdk-chat.test.mjs",
    "test:store": "node --experimental-strip-types --test tests/store.test.mjs",
    "test:exchange": "node --experimental-strip-types --test tests/exchange-rates.test.mjs",
    "test:markdown": "node --experimental-strip-types --test tests/markdown.test.mjs",
    "test:chat": "node --experimental-strip-types --test tests/codex-chat.test.mjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && npm run build:backend && electron-builder --dir",
    "build:win": "npm run build && npm run build:backend && electron-builder --win",
    "build:mac": "npm run build && npm run build:backend && electron-builder --mac",
    "build:linux": "npm run build && npm run build:backend && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@element-plus/icons-vue": "^2.3.2",
    "@openai/codex-sdk": "^0.163.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "lightweight-charts": "^5.2.1",
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
